# ============================================================
#  电商智能客服 AI 服务 —— 环境变量示例
# ============================================================
#  使用方法：
#    复制本文件为 .env，然后填入真实值
#        cp .env.example .env
#    .env 已在 .gitignore 中，不会被提交
# ============================================================


# ------------------------------------------------------------
#  数据库
# ------------------------------------------------------------
# PostgreSQL 连接串，驱动必须是异步的（psycopg3）
# 格式：postgresql+psycopg://<用户名>:<密码>@<主机>:<端口>/<库名>
AI_DATABASE_URL=postgresql+psycopg://user:password@127.0.0.1:5432/ai_customer_service


# ------------------------------------------------------------
#  HTTP 服务
# ------------------------------------------------------------
API_HOST=0.0.0.0
API_PORT=8002


# ------------------------------------------------------------
#  内部服务鉴权
# ------------------------------------------------------------
# 用于校验调用方是否为合法的 customer-service
# 生产环境请替换为足够随机的长字符串
INTERNAL_SERVICE_TOKEN=change-me-internal-token


# ------------------------------------------------------------
#  下游电商服务
# ------------------------------------------------------------
ECOMMERCE_BASE_URL=http://127.0.0.1:8001/api/v1
ECOMMERCE_TIMEOUT_SECONDS=30


# ------------------------------------------------------------
#  用户 JWT 校验
# ------------------------------------------------------------
# 必须与 customer-service 侧签发令牌所用的密钥一致
JWT_SECRET=change-me-jwt-secret
JWT_ALGORITHM=HS256


# ------------------------------------------------------------
#  大语言模型
# ------------------------------------------------------------
# 可选值：openai_compatible | deepseek | qwen
LLM_PROVIDER=openai_compatible

# 模型服务地址（无默认值，必须显式配置）
LLM_BASE_URL=https://api.deepseek.com

# 模型 API Key —— 请填入自己的密钥
LLM_API_KEY=sk-your-api-key-here

# 模型名称
LLM_MODEL=deepseek-chat

# 思考模式：disabled 关闭 | enabled 开启
LLM_THINKING_MODE=disabled

LLM_TIMEOUT_SECONDS=30
LLM_MAX_RETRIES=1


# ------------------------------------------------------------
#  会话上下文控制（可选，不填则使用代码内默认值）
# ------------------------------------------------------------
# 历史消息条数上限（1~60，默认 30）
# HISTORY_MESSAGE_LIMIT=30
# 历史消息字符预算（默认 12000）
# HISTORY_CHARACTER_BUDGET=12000
# 提示词版本标记，会随运行记录落库，便于归因（默认 customer-support-v1）
# PROMPT_VERSION=customer-support-v1
